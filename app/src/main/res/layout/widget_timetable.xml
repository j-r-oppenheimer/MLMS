<?xml version="1.0" encoding="utf-8"?>
<!-- One UI 배경 블러용: 루트가 @android:id/background 이고 반투명 배경(런타임에 틴트).
     이미지(그리드·블록·글씨, 투명 배경) 위에 prev/next 투명 클릭 영역을 올린다. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66FFFFFF">

    <!-- 시간표 비트맵 (그리드·블록·글씨, 투명 배경) -->
    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <!-- 월(이전) / 화수목(무동작) / 금(다음) 터치 구역 — 헤더 행만 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_alignParentTop="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text=""
            android:background="@android:color/transparent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:text=""
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/widget_btn_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text=""
            android:background="@android:color/transparent" />

    </LinearLayout>

</RelativeLayout>
